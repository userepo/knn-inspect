# The extension module: each report as its JSON and its text. The
# package's __init__ is the interface; see its docstrings.
import os
from typing import Any

_Path = str | os.PathLike[str]

__version__: str

class NativeError(Exception): ...

def info(path: _Path, /) -> tuple[str, str]: ...
def verify(path: _Path, space_name: str | None, max_findings: int, /) -> tuple[str, str]: ...
def stats(path: _Path, /) -> tuple[str, str]: ...
def scan(dir: _Path, space_name: str | None, max_findings: int, /) -> tuple[str, str]: ...
def recall(path: _Path, args: dict[str, Any], /) -> tuple[str, str, str | None]: ...
